# IndiAR Environment Variables Example
# Rename this file to .env and modify the values as needed

# MySQL Database
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DB=indiar

# Flask App
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# Server
HOST=0.0.0.0
# Gmail SMTP (contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
SMTP_FROM=IndiAR <tu-correo@gmail.com>

# Google Identity Services (OAuth 2.0 Web client ID; public identifier)
GOOGLE_CLIENT_ID=
